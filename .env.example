# Copiez ce fichier en .env et remplissez les valeurs. Ne commitez jamais .env.

# App Slack (voir slack-manifest.yml et le README).
# Token du bot : OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-
# Token de l'app : Basic Information > App-Level Tokens (scope connections:write)
SLACK_APP_TOKEN=xapp-

# Connexion de Claude Code : remplissez UNE seule des deux lignes.
# Abonnement Claude (Pro/Max) : token obtenu avec `claude setup-token` (sk-ant-oat01-…)
CLAUDE_CODE_OAUTH_TOKEN=
# Ou clé API Anthropic (sk-ant-api03-…), idéalement avec un plafond de dépenses.
ANTHROPIC_API_KEY=

# Modèle utilisé par les rédacteurs.
CLAUDE_MODEL=claude-sonnet-5

# Secret partagé entre l'orchestrateur et les rédacteurs (réseau interne).
# Générez-le avec : openssl rand -hex 32
WORKER_TOKEN=

# Qui a le droit d'utiliser /contenu et de valider. IDs Slack séparés par des
# virgules (profil > ... > Copier l'ID de membre). Vide = tout l'espace de travail.
ALLOWED_USER_IDS=
# Canaux autorisés (IDs, par exemple C0123456789). Vide = tous les canaux.
ALLOWED_CHANNEL_IDS=

# Durée maximale d'une rédaction.
JOB_TIMEOUT_MINUTES=10

# Visuels : clé API OpenAI (platform.openai.com > API keys), avec un plafond de dépenses.
OPENAI_API_KEY=
# Directeur artistique et modèle de dessin.
OPENAI_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Mode abonnement ChatGPT (OPENAI_API_KEY vide) : modèle de Codex. Vide = modèle par défaut.
CODEX_MODEL=

# JEV (TypeSafe AI) via Vercel AI Gateway : vercel.com > AI Gateway > API Keys.
AI_GATEWAY_API_KEY=

# Notion : planning éditorial et publication. Token de l intégration interne (ntn_…).
NOTION_TOKEN=
# Rempli par scripts/notion-setup.mjs.
NOTION_DATABASE_ID=
# Bibliothèque de marque (le contexte). Rempli par scripts/notion-setup.mjs.
NOTION_LIBRARY_ID=
# Canal Slack où arrivent les contenus planifiés. Vide = premier canal de ALLOWED_CHANNEL_IDS.
PLANNING_CHANNEL_ID=

# Autres fournisseurs de modèles (facultatif, voir config/factory.json > engines).
# AI_GATEWAY_API_KEY ci-dessus donne déjà accès à ~390 modèles (Mistral, Gemini, DeepSeek, Flux…).
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Clé libre pour tout autre service compatible OpenAI.
LLM_API_KEY=
